<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Android 12+ paints its own system splash (a solid background plus the app
      icon) before this activity's window exists, and that background defaults to
      the theme's colour background — which is dark in dark mode. Pin it to the
      same white sheet the launch drawable uses so the whole cold start reads as
      one continuous loading screen instead of a dark flash.

      Style resources are not merged across configuration qualifiers, so this
      re-declares the items from values/styles.xml alongside the API 31 ones.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:windowSplashScreenBackground">@color/splash_top</item>
    </style>
</resources>
